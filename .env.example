# Cadena de conexión a Postgres (el contenedor expone 5433 en el host)
DATABASE_URL="postgresql://cms:cms@localhost:5433/cms"

# Contraseña de las cuentas de ejemplo que crea `npm run db:seed`
SEED_PASSWORD="contrasena-de-desarrollo"

# URL pública del sitio (sitemap, RSS y datos estructurados)
SITE_URL="http://localhost:3000"

# Base de datos que usan las pruebas
TEST_DATABASE_URL="postgresql://cms:cms@localhost:5433/cms_test"
